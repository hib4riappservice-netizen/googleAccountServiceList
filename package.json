    "verify:full": "pnpm verify && pnpm test:e2e",
    "check:headers": "node scripts/check-headers.mjs",
    "check:release-age": "node scripts/check-release-age.mjs",
    "check:diff-size": "node scripts/check-diff-size.mjs",
    "check:ci-hygiene": "node scripts/check-ci-hygiene.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@sentry/nextjs": "^10.70.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
