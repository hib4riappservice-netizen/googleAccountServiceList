    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-vitest": "^0.5.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
